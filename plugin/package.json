{
  "name": "@local/reader",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Reader is a local-first ebook workspace for DeepSeek Harness: import EPUB, PDF, TXT, Markdown and HTML, then practise with synced speech, typing, read-aloud matching, vocabulary, mind maps and podcasts.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "reader",
    "epub",
    "pdf",
    "ebook",
    "language-learning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colsonSung/dsh-reader.git"
  },
  "homepage": "https://github.com/colsonSung/dsh-reader#readme",
  "bugs": {
    "url": "https://github.com/colsonSung/dsh-reader/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.pdf.js",
    "build.mjs",
    "cordis.patch.yml",
    "src/**/*",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/**/*"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/client-entry.js && node --check index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
