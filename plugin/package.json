{
  "name": "dsh-reader",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "An English reading practice panel for the DeepSeek Harness: import EPUB, TXT, Markdown, HTML or PDF, then read it sentence by sentence — listen, type along with the synced speech, or read aloud and check the transcript.",
  "license": "MIT",
  "author": "Ethan Song",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colsonSung/dsh-reader.git"
  },
  "homepage": "https://github.com/colsonSung/dsh-reader#readme",
  "bugs": {
    "url": "https://github.com/colsonSung/dsh-reader/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "english",
    "reading",
    "vocabulary",
    "tts",
    "language-learning",
    "reader"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "build.mjs",
    "src",
    "client.js",
    "client.pdf.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node tools/preview/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
